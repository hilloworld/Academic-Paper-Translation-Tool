# ============================================================
#  论文对照阅读器 配置文件（复制为 .env 后填写）
#
#  三种配置方式任选其一（也可以混用）：
#    1) 启动后点界面工具栏的「⚙ 设置」直接填 —— 最省事，写入 data/runtime-config.json，
#       保存即生效、无需重启；改动过的项优先级最高；
#    2) 复制本文件为 .env 并按下面注释填写（适合固定环境）；
#    3) 直接设置系统环境变量，或用 config.json。
#
#  优先级：系统环境变量 > .env > config.json > 内置默认值
#          > 以上全部 < 界面「⚙ 设置」里显式保存过的项
#  ⚠ 本文件只写占位符，请勿把真实 Key 提交到版本库
# ============================================================

# ---------- 大模型服务（默认 DeepSeek） ----------
# provider 可选: deepseek / openai / moonshot / qwen / zhipu / siliconflow / ollama / custom
# 每种 provider 都有内置的 base_url 与 model 预设，通常只需填 LLM_API_KEY
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的DeepSeek密钥

# 下面三项留空则使用 provider 预设；自定义服务商（custom）必须填
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
# 并发请求数（DeepSeek 官方建议 <=4）
LLM_MAX_CONCURRENCY=4
# 每个翻译分块的最大字符数 / 最大片段数
LLM_BATCH_CHARS=1800
LLM_BATCH_SEGMENTS=24
# 单个分块的最大重试次数（429/5xx/网络错误会自动退避重试）
LLM_RETRIES=3
# JSON 输出模式: auto | on | off。auto = 先试 JSON 模式，接口不支持则自动降级
LLM_JSON_MODE=auto

# 离线自检用：置 1 时不调用真实 API，返回模拟译文（仅用于验证链路）
# 也可以在「⚙ 设置」里勾选「模拟模式（不调用 API）」
LLM_MOCK=0

# ---------- 译文语言 ----------
SOURCE_LANG=英语
TARGET_LANG=简体中文

# ---------- 翻译范围过滤 ----------
# 右栏以「原页渲染图」为底，只有可译片段才用白底中文覆盖。
# 默认策略：图片 / 表格 / 公式 / 图表标题 / 参考文献一律不翻译，原样呈现。
# 是否跳过参考文献条目（默认跳过）
SKIP_REFERENCE_BLOCKS=1
# 是否翻译整段公式块（默认保留原文，右栏显示原公式）
TRANSLATE_FORMULA_BLOCKS=0
# 表格：0=整张表原样保留（默认），1=按单元格逐个翻译（符号/缩写格仍保留原文）
TRANSLATE_TABLES=0
# 图表标题（Fig. 1: / TABLE I:）：1=翻译标题（默认），0=原样保留
TRANSLATE_CAPTIONS=1
# 行内公式（嵌在正文里的 x_t / |h_t|^2 / 分式…）：
#   1=不送模型，sent 出去的是占位符，前端再按坐标把原图小块贴回原位（默认）
#   0=当普通文字一起翻译（公式会被模型改写，一般不建议）
INLINE_MATH_IMAGE=1

# ---------- 服务与渲染 ----------
HOST=127.0.0.1
PORT=8000
OPEN_BROWSER=1
# PDF 页面渲染倍率（1 pt -> N px）。2.0 约等于 144 DPI，兼顾清晰与体积
RENDER_ZOOM=2.0
# 数据目录（缓存 / 上传 / 渲染图），相对项目根目录
DATA_DIR=data
